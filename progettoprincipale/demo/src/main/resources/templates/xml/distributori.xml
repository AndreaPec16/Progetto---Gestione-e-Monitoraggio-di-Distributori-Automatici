<?xml version="1.0" encoding="UTF-8"?>
<distributori xmlns:th="http://www.thymeleaf.org">

    <distributore th:each="d : ${distributori}">
        <codice th:text="${d.codiceVisivo}"/>
        <modello th:text="${d.modello}"/>
        <posizione th:text="${d.indirizzo}"/>
        <stato th:text="${d.stato}"/>

        <livelli>
            <acqua th:text="${d.livelloAcqua}"/>
            <zucchero th:text="${d.livelloZucchero}"/>
            <caffe th:text="${d.livelloCaffe}"/>
            <the th:text="${d.livelloTe}"/>
            <latte th:text="${d.livelloLatte}"/>
            <cioccolato th:text="${d.livelloCioccolato}"/>
            <bicchieri th:text="${d.livelloBicchieri}"/>
            <palette th:text="${d.livelloPalette}"/>
        </livelli>

        <locazione>
            <latitudine th:text="${d.latitudine}"/>
            <longitudine th:text="${d.longitudine}"/>
        </locazione>
    </distributore>
</distributori>